 * Issue a credit note to adjust the amount of a finalized invoice. A credit note
 * will first reduce the invoice’s <code>amount_remaining</code> (and
 * <code>amount_due</code>), but not below zero. This amount is indicated by the
 * credit note’s <code>pre_payment_amount</code>. The excess amount is indicated by
 * <code>post_payment_amount</code>, and it can result in any combination of the
 * following:
 *
 * <ul> <li>Refunds: create a new refund (using <code>refund_amount</code>) or link
 * existing refunds (using <code>refunds</code>).</li> <li>Customer balance credit:
 * credit the customer’s balance (using <code>credit_amount</code>) which will be
 * automatically applied to their next invoice when it’s finalized.</li>
 * <li>Outside of Stripe credit: record the amount that is or will be credited
 * outside of Stripe (using <code>out_of_band_amount</code>).</li> </ul>
 *
 * The sum of refunds, customer balance credits, and outside of Stripe credits must
 * equal the <code>post_payment_amount</code>.
 *
 * You may issue multiple credit notes for an invoice. Each credit note may
 * increment the invoice’s <code>pre_payment_credit_notes_amount</code>,
 * <code>post_payment_credit_notes_amount</code>, or both, depending on the
 * invoice’s <code>amount_remaining</code> at the time of credit note creation.
 *
 * For invoices that also have refunds created through the <a
 * href="/docs/api/refunds">Refund API</a>, the credit note API subtracts those
 * refund amounts from the maximum creditable amount. This prevents the combined
 * credit notes and refunds from exceeding the invoice amount. If you use both,
 * ensure the combined total does not exceed the invoice’s paid amount.
 *
 * @param null|array{amount?: int, credit_amount?: int, effective_at?: int, email_type?: string, expand?: string[], invoice: string, lines?: (array{amount?: int, description?: string, invoice_line_item?: string, metadata?: array<string, string>, quantity?: int, tax_amounts?: null|array{amount: int, tax_rate: string, taxable_amount: int}[], tax_rates?: null|string[], type: string, unit_amount?: int, unit_amount_decimal?: string})[], memo?: string, metadata?: array<string, string>, out_of_band_amount?: int, reason?: string, refund_amount?: int, refunds?: array{amount_refunded?: int, payment_record_refund?: array{payment_record: string, refund_group: string}, refund?: string, type?: string}[], shipping_cost?: array{shipping_rate?: string}} $params
 * @param null|RequestOptionsArray|\Stripe\Util\RequestOptions $opts
 *
 * @return \Stripe\CreditNote
 *
 * @throws \Stripe\Exception\ApiErrorException if the request fails
 */";s:9:"startLine";i:83;s:7:"endLine";i:86;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:14:"Stripe\Service";s:18:"declaringClassName";s:32:"Stripe\Service\CreditNoteService";s:21:"implementingClassName";s:32:"Stripe\Service\CreditNoteService";s:16:"currentClassName";s:32:"Stripe\Service\CreditNoteService";s:9:"aliasName";N;}s:7:"preview";a:20:{s:4:"name";s:7:"preview";s:10:"parameters";a:2:{s:6:"params";a:13:{s:4:"name";s:6:"params";s:7:"default";a:2:{s:4:"code";s:4:"null";s:10:"attributes";a:6:{s:9:"startLine";i:98;s:7:"endLine";i:98;s:13:"startTokenPos";i:179;s:12:"startFilePos";i:5801;s:11:"endTokenPos";i:179;s:10:"endFilePos";i:5804;}}s:4:"type";N;s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:98;s:7:"endLine";i:98;s:11:"startColumn";i:29;s:9:"endColumn";i:42;s:14:"parameterIndex";i:0;s:10:"isOptional";b:1;}s:4:"opts";a:13:{s:4:"name";s:4:"opts";s:7:"default";a:2:{s:4:"code";s:4:"null";s:10:"attributes";a:6:{s:9:"startLine";i:98;s:7:"endLine";i:98;s:13:"startTokenPos";i:186;s:12:"startFilePos";i:5815;s:11:"endTokenPos";i:186;s:10:"endFilePos";i:5818;}}s:4:"type";N;s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:98;s:7:"endLine";i:98;s:11:"startColumn";i:45;s:9:"endColumn";i:56;s:14:"parameterIndex";i:1;s:10:"isOptional";b:1;}}s:16:"returnsReference";b:0;s:10:"returnType";N;s:10:"attributes";a:0:{}s:10:"docComment";s:993:"/**
