 * Pilote d'envoi des e-mails, choisi par configuration.
 *
 * `ArrayMailSender` est enregistré comme singleton sous son propre nom, et
 * pas seulement derrière le contrat : les tests le redemandent par sa
 * classe concrète (`tests\TestCase::mailbox()`) pour inspecter les envois,
 * et doivent obtenir exactement l'instance que les services ont reçue, pas
 * une seconde en double.
 *
 * Un pilote inconnu lève au lieu de retomber sur un autre : une plateforme
 * qui croit envoyer ses liens de vérification alors qu'elle les jette ne
 * se découvrirait qu'au premier client bloqué.
 */";s:9:"startLine";i:105;s:7:"endLine";i:122;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:1;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:4;s:9:"namespace";s:13:"App\Providers";s:18:"declaringClassName";s:35:"App\Providers\DomainServiceProvider";s:21:"implementingClassName";s:35:"App\Providers\DomainServiceProvider";s:16:"currentClassName";s:35:"App\Providers\DomainServiceProvider";s:9:"aliasName";N;}s:19:"registerAuthSupport";a:20:{s:4:"name";s:19:"registerAuthSupport";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:124;s:7:"endLine";i:142;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:4;s:9:"namespace";s:13:"App\Providers";s:18:"declaringClassName";s:35:"App\Providers\DomainServiceProvider";s:21:"implementingClassName";s:35:"App\Providers\DomainServiceProvider";s:16:"currentClassName";s:35:"App\Providers\DomainServiceProvider";s:9:"aliasName";N;}}s:10:"traitsData";a:4:{s:7:"aliases";a:0:{}s:9:"modifiers";a:0:{}s:11:"precedences";a:0:{}s:6:"hashes";a:0:{}}}}