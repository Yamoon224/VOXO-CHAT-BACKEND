<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:dGVzdC1hcHAta2V5LW5vdC1hLXNlY3JldC0wMDAwMDA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            Les tests tournent sur MySQL, comme la production : l'isolation
            repose sur des contraintes d'unicité et du verrouillage de ligne,
            que SQLite ne reproduit pas fidèlement.

            Seuls le moteur et le nom de la base sont fixés ici. L'hôte, le
            port et les identifiants viennent du .env de chaque poste (ou des
            variables d'environnement en CI) : aucun secret dans ce fichier.
            La base de test est distincte de la base applicative.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="voxo_testing"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>

        <!-- Réglages métier figés : les tests ne dépendent pas du .env local. -->
        <env name="VOXO_MAIL_DRIVER" value="array"/>
        <env name="FRONTEND_URL" value="http://localhost:3000"/>
        <env name="INVITATION_TTL_HOURS" value="168"/>
        <env name="EMAIL_VERIFICATION_TTL_MINUTES" value="1440"/>
        <env name="TWO_FACTOR_ISSUER" value="VOXO"/>
        <env name="SANCTUM_TOKEN_EXPIRATION" value="720"/>

        <!-- Base de connaissances : pilotes sans appel réseau pour les tests. -->
        <env name="KNOWLEDGE_EMBEDDINGS_DRIVER" value="array"/>
        <env name="KNOWLEDGE_OCR_DRIVER" value="array"/>
        <env name="KNOWLEDGE_CRAWLER_DRIVER" value="array"/>

        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
