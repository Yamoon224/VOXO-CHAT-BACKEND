{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "voxo/backend",
    "type": "project",
    "description": "API REST de VOXO : plateforme SaaS multi-tenant de support client assiste par IA.",
    "keywords": [
        "voxo",
        "support-client",
        "saas",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "4.*",
        "laravel/tinker": "^3.0",
        "phpoffice/phpspreadsheet": "^3.5",
        "phpoffice/phpword": "^1.3",
        "pragmarx/google2fa": "8.*",
        "smalot/pdfparser": "^2.12",
        "spatie/laravel-activitylog": "4.*",
        "spatie/laravel-permission": "8.*",
        "stripe/stripe-php": "^22.0",
        "symfony/css-selector": "7.*",
        "symfony/dom-crawler": "7.*",
        "symfony/yaml": "7.*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "3.*",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan db:seed --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:unit": [
            "@php artisan test --testsuite=Unit"
        ],
        "test:feature": [
            "@php artisan test --testsuite=Feature"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "format": [
            "vendor/bin/pint"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --no-progress --memory-limit=1G"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "docs:assets": [
            "npm install --no-audit --no-fund",
            "npm run docs:assets"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "scripts-descriptions": {
        "setup": "Installation complete : dependances, .env, cles, migrations, roles et permissions.",
        "test": "Suite complete : tests unitaires et d'integration (MySQL).",
        "test:unit": "Tests unitaires seuls, sans base de donnees.",
        "test:feature": "Tests d'integration seuls, sur la base de test MySQL.",
        "lint": "Verifie le formatage (Pint) sans rien modifier.",
        "format": "Applique le formatage Pint.",
        "analyse": "Analyse statique PHPStan/Larastan.",
        "check": "Porte de sortie avant livraison : lint + analyse statique + tests.",
        "docs:assets": "Recopie les assets Swagger UI dans public/vendor/swagger-ui."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
