APP_NAME=VOXO
APP_ENV=local
# Généré par `php artisan key:generate` — ne jamais committer de vraie clé.
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données ---------------------------------------------------------
# MySQL 8 (Laragon). Les deux bases doivent exister avant la première migration :
#   CREATE DATABASE voxo CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE DATABASE voxo_testing CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# Le cahier des charges visait PostgreSQL + pgvector pour la recherche
# vectorielle de la base de connaissances (lot 1). Décision révisée : MySQL,
# plus simple à opérer sur l'environnement de développement actuel. Le moteur
# de recherche vectorielle (service dédié, ou extension MySQL) reste à
# trancher au lot 1 — voir section 12 du cahier des charges.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voxo
DB_USERNAME=root
DB_PASSWORD=

# API par jeton, sans état : aucune session serveur à conserver.
SESSION_DRIVER=array

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# `database` suffit en développement. La production utilise Redis
# (QUEUE_CONNECTION=redis, CACHE_STORE=redis) : voir le cahier des charges.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mails -----------------------------------------------------------------
# `log` écrit les e-mails dans storage/logs au lieu de les envoyer : les liens
# de vérification et d'invitation s'y lisent en développement.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@voxo.test"
MAIL_FROM_NAME="${APP_NAME}"

# Pilote applicatif : `laravel` (transport ci-dessus) ou `array` (tests).
VOXO_MAIL_DRIVER=laravel

# --- Frontend / CORS ---------------------------------------------------------
# Origine de l'application Next.js : liens des e-mails et origine autorisée.
# Séparer par des virgules pour autoriser plusieurs origines.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Durée de validité d'un jeton d'API, en minutes. Passé ce délai l'API répond
# 401 et l'application referme la session.
SANCTUM_TOKEN_EXPIRATION=720

# --- Comptes -----------------------------------------------------------------
INVITATION_TTL_HOURS=168
EMAIL_VERIFICATION_TTL_MINUTES=1440
TWO_FACTOR_ISSUER=VOXO

# --- Base de connaissances (lot 1) --------------------------------------------
# Embeddings : Voyage AI. Recherche vectorielle : MySQL (similarité cosinus en
# PHP), pas de pgvector. OCR : lecture d'image par Claude. Décisions du
# 8 octobre 2026, section 12 du cahier des charges.
KNOWLEDGE_EMBEDDINGS_DRIVER=voyage
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5

KNOWLEDGE_OCR_DRIVER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_OCR_MODEL=claude-haiku-4-5

KNOWLEDGE_CRAWLER_DRIVER=http
KNOWLEDGE_CRAWLER_MAX_PAGES=50
KNOWLEDGE_STORAGE_DISK=local
KNOWLEDGE_MAX_UPLOAD_KB=20480

# --- Conversation : agent IA et widget (lot 2) --------------------------------
# Réutilise ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL déclarées ci-dessus.
ASSISTANT_AI_DRIVER=claude
ANTHROPIC_RESPOND_MODEL=claude-sonnet-5-5
ANTHROPIC_SHORT_TASK_MODEL=claude-haiku-4-5

WIDGET_SCRIPT_BASE_URL=
WIDGET_VISITOR_SESSION_TTL_MINUTES=259200

# --- Mise en vente : facturation et paiements (lot 3) -------------------------
# Grille tarifaire indicative, à ajuster sans toucher au code (voir
# database/seeders/PlansSeeder) — décision du 9 octobre 2026, section 12 du
# cahier des charges. Stripe derrière PaymentGatewayContract : un autre
# prestataire pourra le remplacer sans changer les domaines appelants.
PAYMENTS_GATEWAY_DRIVER=stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
