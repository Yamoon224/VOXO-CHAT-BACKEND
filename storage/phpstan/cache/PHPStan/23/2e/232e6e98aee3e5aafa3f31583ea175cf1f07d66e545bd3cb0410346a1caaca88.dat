 * @throws \Stripe\Exception\ApiErrorException if the request fails
 */";s:9:"startLine";i:85;s:7:"endLine";i:88;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:14:"Stripe\Service";s:18:"declaringClassName";s:35:"Stripe\Service\PaymentIntentService";s:21:"implementingClassName";s:35:"Stripe\Service\PaymentIntentService";s:16:"currentClassName";s:35:"Stripe\Service\PaymentIntentService";s:9:"aliasName";N;}s:7:"capture";a:20:{s:4:"name";s:7:"capture";s:10:"parameters";a:3:{s:2:"id";a:13:{s:4:"name";s:2:"id";s:7:"default";N;s:4:"type";N;s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:108;s:7:"endLine";i:108;s:11:"startColumn";i:29;s:9:"endColumn";i:31;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:6:"params";a:13:{s:4:"name";s:6:"params";s:7:"default";a:2:{s:4:"code";s:4:"null";s:10:"attributes";a:6:{s:9:"startLine";i:108;s:7:"endLine";i:108;s:13:"startTokenPos";i:249;s:12:"startFilePos";i:5531;s:11:"endTokenPos";i:249;s:10:"endFilePos";i:5534;}}s:4:"type";N;s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:108;s:7:"endLine";i:108;s:11:"startColumn";i:34;s:9:"endColumn";i:47;s:14:"parameterIndex";i:1;s:10:"isOptional";b:1;}s:4:"opts";a:13:{s:4:"name";s:4:"opts";s:7:"default";a:2:{s:4:"code";s:4:"null";s:10:"attributes";a:6:{s:9:"startLine";i:108;s:7:"endLine";i:108;s:13:"startTokenPos";i:256;s:12:"startFilePos";i:5545;s:11:"endTokenPos";i:256;s:10:"endFilePos";i:5548;}}s:4:"type";N;s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:108;s:7:"endLine";i:108;s:11:"startColumn";i:50;s:9:"endColumn";i:61;s:14:"parameterIndex";i:2;s:10:"isOptional";b:1;}}s:16:"returnsReference";b:0;s:10:"returnType";N;s:10:"attributes";a:0:{}s:10:"docComment";s:1695:"/**
 * Capture the funds of an existing uncaptured PaymentIntent when its status is
 * <code>requires_capture</code>.
 *
 * Uncaptured PaymentIntents are cancelled a set number of days (7 by default)
 * after their creation.
 *
 * Learn more about <a href="/docs/payments/capture-later">separate authorization
 * and capture</a>.
 *
 * @param string $id
 * @param null|array{amount_details?: array{discount_amount?: null|int, enforce_arithmetic_validation?: bool, line_items?: null|array{discount_amount?: int, payment_method_options?: array{card?: array{commodity_code?: string}, card_present?: array{commodity_code?: string}, klarna?: array{image_url?: string, product_url?: string, reference?: string, subscription_reference?: string}, paypal?: array{category?: string, description?: string, sold_by?: string}}, product_code?: string, product_name: string, quantity: int, tax?: array{total_tax_amount: int}, unit_cost: int, unit_of_measure?: string}[], shipping?: null|array{amount?: null|int, from_postal_code?: null|string, to_postal_code?: null|string}, tax?: null|array{total_tax_amount: int}}, amount_to_capture?: int, application_fee_amount?: int, expand?: string[], final_capture?: bool, hooks?: array{inputs?: array{tax?: array{calculation: null|string}}}, metadata?: null|array<string, string>, payment_details?: null|array{customer_reference?: null|string, order_reference?: null|string}, statement_descriptor?: string, statement_descriptor_suffix?: string, transfer_data?: array{amount?: int}} $params
 * @param null|RequestOptionsArray|\Stripe\Util\RequestOptions $opts
