includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Un chemin dans le projet : le dossier temporaire par defaut, derriere un
    # lien symbolique Windows court (~1), fait echouer la creation de
    # sous-dossiers de cache sur cet environnement.
    tmpDir: storage/phpstan

    paths:
        - app
        - database
        - routes
        - tests

    # Niveau 6 : types de parametres et de retour exiges partout, contenu des
    # tableaux documente. Au-dela, Larastan bute surtout sur le typage
    # dynamique d'Eloquent, pour un gain reel faible sur ce projet.
    level: 6
